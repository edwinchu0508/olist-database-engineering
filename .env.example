# Copy to .env and adjust. Variables already set in the environment win over this file.
# PG* variables are deliberately not used, so settings left over from another project in the same
# terminal cannot redirect this one. Never put a password here: libpq reads it from pgpass.conf.
OLIST_DBE_HOST=localhost
OLIST_DBE_PORT=5432
OLIST_DBE_USER=dbe_owner
OLIST_DBE_DB=olist_dbe

# Database used by pytest. It must end in _test and carry the 'test' purpose marker.
OLIST_DBE_TEST_DB=olist_dbe_test

# PostgreSQL's bin folder, if psql (olist-dbe bootstrap) and initdb/pg_ctl (tests/test_bootstrap.py)
# are not on PATH.
# OLIST_DBE_PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Folder holding the nine Olist CSV files.
OLIST_DATA_DIR=D:\project
